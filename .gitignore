# Visual Studio / Rider / Cursor
.vscode/
.idea/
*.sln
*.suo
*.opensdf
*.sdf
*.vsconfig

# Unreal Engine Generated Files
Binaries/
DerivedDataCache/
Intermediate/
Saved/*
# ...except the Blender authoring file: it is the SOURCE for every clip we author
# (the wall spring/sail and the M5 batch). The .uassets are committed, but losing
# this means redoing the pose surgery from scratch rather than just re-exporting.
# NOTE the `Saved/*` form above: an ignored DIRECTORY (`Saved/`) is never descended
# into, so a negation for a file inside it can never match.
!Saved/BlenderExchange/
Saved/BlenderExchange/*
!Saved/BlenderExchange/M5_authoring.blend
Build/
Script/

# Vibe Coding 2.0 sandbox — third-party plugin source not tracked on this branch
Plugins/VibeUE/

# MCP server config — contains the local VibeUE API key, never commit
.mcp.json

# SteamPipe build artifacts (BuildCookRun + steamcmd scratch dirs)
ArchivedBuilds/
BuildOutput/
Saved/StagedBuilds/

# OS Files
.DS_Store
Thumbs.db